@@ -21,0 +22,11 @@ logger = get_logger(__name__)
+def masked_action_time_mean(
+    loss_token: torch.Tensor, action_is_pad: torch.Tensor | None
+) -> torch.Tensor:
+    """Average only real command slots, without changing sample weighting."""
+    if action_is_pad is None:
+        return loss_token.mean(dim=1)
+    pad = action_is_pad.to(device=loss_token.device, dtype=torch.bool)
+    valid_count = (~pad).sum(dim=1).clamp_min(1).to(loss_token.dtype)
+    return loss_token.masked_fill(pad, 0.0).sum(dim=1) / valid_count
+
