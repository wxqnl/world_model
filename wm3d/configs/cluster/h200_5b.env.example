# Copy this file outside the repository and edit every REQUIRED value.
# Shell variable expansion is intentional; do not put commands in this file.

# The wrapper maps this preset to a sealed runtime profile and final step.
# init accepts: canary1k, validation10k, validation100k, formal600k.
WM3D_5B_PRESET=validation10k
# Use a new ID for every independent run of the same preset.
WM3D_5B_RUN_ID=${WM3D_5B_PRESET}
DATA_FAMILY=public_robot_6106h

# Shared storage visible at the same absolute path on every node.
WORK_ROOT=/shared/wm3d
CONTROL_ROOT=${WORK_ROOT}/control
RAW_ROOT=${WORK_ROOT}/raw
CACHE_ROOT=${WORK_ROOT}/cache/native_p144

# Data access mode. episode_cache is fastest and remains the default.
# streaming_raw keeps only small metadata globally and builds a bounded,
# rank-local episode LRU from raw videos during training.
WM3D_DATA_MODE=episode_cache
STREAMING_METADATA_ROOT=${WORK_ROOT}/streaming_metadata/native_p144
STREAMING_METADATA_SEAL=${STREAMING_METADATA_ROOT}/metadata_seal_5b.json
# Put this on node-local NVMe at the same absolute path on every node.
STREAMING_LRU_ROOT=/local_nvme/wm3d_streaming_lru
STREAMING_LRU_GIB_PER_RANK=64
STREAMING_METADATA_WORKERS=32
STREAMING_ENCODE_BATCH_FRAMES=16
STREAMING_DECODE_WORKERS=4

# Environment and download credentials. The token file must be chmod 600.
ENV_DIR=${WORK_ROOT}/envs/wm3d-cu128
PYTHON_BIN=${ENV_DIR}/bin/python
HF_TOKEN_FILE=/shared/secrets/huggingface_token
ACCEPT_DATA_LICENSES=NO
HF_HOME=${WORK_ROOT}/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
DOWNLOAD_WORKERS=32

# Frozen encoder source/model assets. Download them once and copy to shared storage.
WM3D_VGGT_SOURCE_ROOT=/shared/models/vggt/a288dd0f14786c93483e45524328726ab7b1b4ce
WM3D_VGGT_MODEL_SNAPSHOT=/shared/models/huggingface/facebook-VGGT-1B/860abec7937da0a4c03c41d3c269c366e82abdf9
QWEN3_VL_EMBEDDING_PATH=/shared/models/huggingface/Qwen3-VL-Embedding-2B/9f2f7e710d6d81056aa5c0a4f04764fec6bb7bda

# Source and data contracts. DATA_PROFILE must be supplied by the project owner after adapter
# semantics and source inventories have been audited. A template is not trainable.
SOURCE_TEMPLATE=configs/sources/public_sources.template.yaml
SOURCE_LOCK=${CONTROL_ROOT}/public_sources.lock.yaml
DATA_TEMPLATE=configs/data/public_robot_6106h.template.yaml
DATA_PROFILE=${CONTROL_ROOT}/public_robot_6106h.yaml

# Cache and runtime outputs. These are content-addressed or no-clobber artifacts.
TASK_BANK_ROOT=${CACHE_ROOT}/task_bank
TASK_BANK_INDEX=${TASK_BANK_ROOT}/index.jsonl
TASK_MANIFEST=${CACHE_ROOT}/cache_tasks.jsonl
EPISODE_INDEX=${CACHE_ROOT}/episode_index.jsonl
EPISODE_SEAL=${CACHE_ROOT}/episode_seal.json
WINDOW_INDEX=${CACHE_ROOT}/window_index_5b.jsonl
WINDOW_SEAL=${CACHE_ROOT}/window_seal_5b.json
GROUPED_NORMALIZATION=${CACHE_ROOT}/grouped_normalization_5b.json

# Model/data profiles shared by all four 5B schedules.
MODEL_PROFILE=configs/model/native_5b.yaml
ENCODER_CONTRACT=configs/encoder/vggt_native_p144.yaml
TASK_ENCODER_CONTRACT=configs/encoder/task_qwen3_vl_embedding_2b.yaml
OBJECTIVE_PROFILE=configs/objective/stage0_native.yaml

# Cache parallelism. One cache worker owns one GPU and is safely re-entrant.
CACHE_WORKER_COUNT=64
CACHE_BATCH_FRAMES=16
CACHE_DECODE_WORKERS=4
CACHE_WRITER_THREADS=2
TASK_DEVICE=cuda:0

# 8 nodes x 8 H200. Slurm launchers use SLURM_PROCID as NODE_RANK.
NNODES=8
GPUS_PER_NODE=8
NODE_RANK=${NODE_RANK:-${SLURM_PROCID:-0}}
MASTER_ADDR=${MASTER_ADDR:-REQUIRED_MASTER_ADDR}
PREFLIGHT_PORT=${PREFLIGHT_PORT:-29610}
TRAIN_PORT=${TRAIN_PORT:-29611}
EVAL_PORT=${EVAL_PORT:-29612}
