# Copy this file outside the repository and edit every site-specific value.
# Shell variable expansion is intentional; never put commands or secrets here.

# init accepts canary1k and formal100k. Use a new run ID for every independent run.
WM3D_1B_PRESET=canary1k
WM3D_1B_RUN_ID=${WM3D_1B_PRESET}
DATA_FAMILY=public_robot_oxe

# This 1B recipe is exactly 60 sources: DROID, Bridge, three RoboCasa families,
# plus all official LeRobot OXE datasets after de-duplicating DROID.
INCLUDE_AGIBOT_2026=NO
INCLUDE_AGIBOT_BETA=NO

# RAW_ROOT must contain every frozen raw source revision. direct_raw reads only
# the sealed T+K RGB window; it never creates a latent/episode visual cache.
WORK_ROOT=/data/wm3d_1b_oxe
CONTROL_ROOT=${WORK_ROOT}/control
RAW_ROOT=${WORK_ROOT}/raw
CACHE_ROOT=${WORK_ROOT}/cache/native_p64
# Direct mode does not reserve space for a full visual cache. Audit the actual
# frozen raw inventory at the site instead of imposing the old 25 TB gate.
MINIMUM_RAW_FILESYSTEM_BYTES=0

WM3D_DATA_MODE=direct_raw
STREAMING_METADATA_ROOT=${WORK_ROOT}/streaming_metadata/native_p64
STREAMING_METADATA_SEAL=${STREAMING_METADATA_ROOT}/metadata_seal_1b.json
STREAMING_METADATA_WORKERS=32

# Rank-local frozen VGGT runs before the trainable world model.  Chunk 32 is
# the speed default and automatically halves only on an encoder CUDA OOM.
DIRECT_INPUT_RGB_SIZE=518
DIRECT_DECODE_WORKERS=4
DIRECT_ROBOT_CACHE_EPISODES=8
# Two official micro-batches (2 x 8) can be decoded ahead while the GPU trains.
# This is raw uint8 RGB only and is a fixed memory bound, not a latent cache.
DIRECT_PREFETCH_WINDOWS=16
DIRECT_VIDEO_INDEX_CACHE_ASSETS=128
DIRECT_ENCODE_CHUNK_ROWS=32
DIRECT_MINIMUM_CHUNK_ROWS=4
DIRECT_APPEARANCE_FEATURE_LAYER=4

# Environment and download credentials. The token file must be chmod 600.
ENV_DIR=${WORK_ROOT}/envs/wm3d-cu128
PYTHON_BIN=${ENV_DIR}/bin/python
HF_TOKEN_FILE=/data/secrets/huggingface_token
ACCEPT_DATA_LICENSES=NO
HF_HOME=${WORK_ROOT}/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
DOWNLOAD_WORKERS=32

# Frozen encoder source/model assets.
WM3D_VGGT_SOURCE_ROOT=/data/models/vggt/a288dd0f14786c93483e45524328726ab7b1b4ce
WM3D_VGGT_MODEL_SNAPSHOT=/data/models/huggingface/facebook-VGGT-1B/860abec7937da0a4c03c41d3c269c366e82abdf9
QWEN3_VL_EMBEDDING_PATH=/data/models/huggingface/Qwen3-VL-Embedding-2B/9f2f7e710d6d81056aa5c0a4f04764fec6bb7bda

# Generated templates are not trainable. DATA_PROFILE is filled only after schema,
# adapter semantics and source inventories have been audited and sealed.
SOURCE_TEMPLATE=${CONTROL_ROOT}/public_sources_1b_oxe.template.yaml
SOURCE_LOCK=${CONTROL_ROOT}/public_sources_1b_oxe.lock.yaml
DATA_TEMPLATE=${CONTROL_ROOT}/public_robot_1b_oxe.template.yaml
DATA_PROFILE=${CONTROL_ROOT}/public_robot_1b_oxe.yaml

TASK_BANK_ROOT=${CACHE_ROOT}/task_bank
TASK_BANK_INDEX=${TASK_BANK_ROOT}/index.jsonl
TASK_MANIFEST=${CACHE_ROOT}/cache_tasks.jsonl
EPISODE_INDEX=${CACHE_ROOT}/episode_index.jsonl
EPISODE_SEAL=${CACHE_ROOT}/episode_seal.json
WINDOW_INDEX=${CACHE_ROOT}/window_index_1b.jsonl
WINDOW_SEAL=${CACHE_ROOT}/window_seal_1b.json
GROUPED_NORMALIZATION=${CACHE_ROOT}/grouped_normalization_1b.json

MODEL_PROFILE=configs/model/native_1b_dual_path.yaml
ENCODER_CONTRACT=configs/encoder/vggt_native_p64_appearance_p256.yaml
TASK_ENCODER_CONTRACT=configs/encoder/task_qwen3_vl_embedding_2b.yaml
OBJECTIVE_PROFILE=configs/objective/stage0_native_dual_path.yaml

# These are used only if an operator deliberately switches back to episode_cache.
CACHE_WORKER_COUNT=8
CACHE_BATCH_FRAMES=16
CACHE_DECODE_WORKERS=4
CACHE_WRITER_THREADS=2
TASK_DEVICE=cuda:0

# node43: one host with eight H100 80GB GPUs.
NNODES=1
GPUS_PER_NODE=8
NODE_RANK=0
MASTER_ADDR=127.0.0.1
PREFLIGHT_PORT=${PREFLIGHT_PORT:-29620}
TRAIN_PORT=${TRAIN_PORT:-29621}
EVAL_PORT=${EVAL_PORT:-29622}
