+++ b/wm3d/wm3d/training/benchmark_recovery.py
@@ -0,0 +1,82 @@
+"""Strict full-state benchmark continuation across a decoder-only implementation fix."""
+from __future__ import annotations
+import copy,json,random,time,stat
+from pathlib import Path
+import numpy as np
+import torch
+import torch.distributed as dist
+from .runtime_contract import load_materialized_runtime
+from .distributed_checkpoint import _atomic_json
+RUNS=Path("/data/Minko/wm3d_native_fresh_pretraining_20260930/downstream_runs_20261028")
+
+def _files(root):
+ result={}
+ for p in root.rglob("*"):
+  s=p.lstat()
+  if stat.S_ISLNK(s.st_mode):raise ValueError("recovery source contains symlink")
+  if p.is_file():
+   if not stat.S_ISREG(s.st_mode):raise ValueError("recovery source not regular")
+   result[str(p.relative_to(root))]=[s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns]
+ return result
+
+def prepare(config,args):
+ if not(args.resume is not None and args.resume_source_runtime and args.resume_cpu_proof):
+  raise ValueError("decoder recovery requires explicit own CP, original runtime and own full CPU proof")
+ if args.qualify_capacity or args.stop_after_step is not None or args.restore_only:
+  raise ValueError("recovery cannot reset/qualify/bound optimizer updates")
+ source,binding=load_materialized_runtime(Path(args.resume_source_runtime))
+ a,b=copy.deepcopy(source),copy.deepcopy(config)
+ for v in (a,b):
+  for key in ("code_commit","output_root"):v["run"].pop(key)
+ if a!=b:raise ValueError("decoder recovery changed model/data/optimizer/LR/batch/updates/sampling/lineage/environment")
+ if source["data_closure"].get("benchmark")!="RoboNet":raise ValueError("only this declared RoboNet decoder recovery is admitted")
+ old=Path(source["run"]["output_root"]);new=Path(config["run"]["output_root"])
+ if old.parent!=RUNS or new.parent!=RUNS or new==old:raise ValueError("new isolated identity required")
+ cp=Path(args.resume).resolve(strict=True)
+ if cp.parent!=old/"checkpoints":raise ValueError("source must be this own original SFT checkpoint")
+ index=json.loads((old/"checkpoint_index.json").read_text())
+ if index["entries"][-1]["path"]!=str(cp):raise ValueError("source is not latest own complete CP")
+ proof=json.loads(Path(args.resume_cpu_proof).read_text())
+ if not(proof["passed"] and proof["source_unchanged"] and proof["CPU_full_DCP_read_returned"] and proof["all_tensors_finite"] and not proof["GPU_initialized"]):raise ValueError("full own CPU proof missing")
+ if proof["source_checkpoint"]!=str(cp) or proof["world_size"]!=8 or proof["model_tensors"]!=2354 or proof["adam_states"]!=2157 or len(proof["rank_states"])!=8:raise ValueError("full CPU proof identity mismatch")
+ if _files(cp)!=proof["source_files"]:raise ValueError("own CPU-validated source changed")
+ meta=json.loads((cp/"metadata.json").read_text())
+ if meta["capacity_qualification_only"] or meta["runtime_config_sha256"]!=binding:raise ValueError("source runtime not exact original formal source")
+ if meta["step"]!=proof["source_step"] or meta["step"]!=proof["all_Adam_parameter_steps"]:raise ValueError("saved model/Adam step mismatch")
+ contract=json.loads((old/"run_contract.json").read_text())
+ if contract["code_commit"]!=source["run"]["code_commit"]:raise ValueError("source code provenance mismatch")
+ return dict(source_config=source,source_binding=binding,cpu_proof=proof,cpu_proof_path=str(args.resume_cpu_proof),warmstart_model=contract.get("warmstart_model"),source_checkpoint=str(cp))
+
+def verify_loaded(recovery,*,model,optimizer,metadata,progress,context,output_root):
+ step=recovery["cpu_proof"]["source_step"]
+ if metadata["step"]!=step or progress["next_optimizer_step"]!=step:raise ValueError("actual loaded sampler/step mismatch")
+ def local(t):return t.to_local() if hasattr(t,"to_local") else t
+ tensors=[local(v.detach()) for v in model.state_dict().values() if isinstance(v,torch.Tensor)]
+ finite=True
+ for v in tensors:
+  if v.is_floating_point():
+   for part in v.reshape(-1).split(4<<20):finite=finite and bool(torch.isfinite(part).all())
+ count=0;moments=0
+ for group in optimizer.param_groups:
+  for p in group["params"]:
+   state=optimizer.state[p]
+   if set(state)!={"step","exp_avg","exp_avg_sq"}:raise ValueError("actual restored Adam state incomplete")
+   if float(local(state["step"]).item())!=step:raise ValueError("actual restored Adam step differs")
+   for k in ("exp_avg","exp_avg_sq"):
+    v=local(state[k])
+    if v.dtype!=torch.float32:raise ValueError("restored moment precision changed")
+    for part in v.reshape(-1).split(4<<20):finite=finite and bool(torch.isfinite(part).all())
+    moments+=1
+   count+=1
+ saved=torch.load(Path(recovery["source_checkpoint"])/"rank_state"/f"rank_{context.rank:05d}.pt",map_location="cpu",weights_only=False)
+ rng=saved["rng"];np_now=np.random.get_state()
+ rng_equal=(random.getstate()==rng["python"] and np_now[0]==rng["numpy"][0] and np.array_equal(np_now[1],rng["numpy"][1]) and np_now[2:]==rng["numpy"][2:] and torch.equal(torch.get_rng_state(),rng["torch_cpu"]) and torch.equal(torch.cuda.get_rng_state(context.device),rng["torch_cuda"]))
+ if not(finite and count==2157 and moments==4314 and rng_equal):raise ValueError("full actual model/Adam/same-rank RNG restore verification failed")
+ row=dict(rank=context.rank,model_tensors=len(tensors),all_model_and_moments_finite=finite,Adam_states=count,Adam_moments=moments,all_Adam_parameter_steps=step,same_rank_Python_NumPy_TorchCPU_CUDA_RNG_equal=rng_equal,sampler_next_optimizer_step=progress["next_optimizer_step"])
+ rows=[None]*context.world_size;dist.all_gather_object(rows,row)
+ if context.is_rank0:
+  value=dict(schema="wm3d_benchmark_actual_full_recovery_v1",at_unix=time.time(),passed=True,source_checkpoint=recovery["source_checkpoint"],source_step=step,next_optimizer_step=step+1,source_CPU_full_proof=recovery["cpu_proof_path"],ranks=rows,model_optimizer_sampler_RNG_restored=True,first_optimizer_not_yet_claimed=True,original_unsaved_updates_require_recomputation=True)
+  _atomic_json(Path(output_root)/"FULL_RESTORE_VERIFIED.json",value)
+  print(json.dumps({"benchmark_full_recovery":value}),flush=True)
+ return rows
+
