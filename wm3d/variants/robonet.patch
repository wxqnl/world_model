--- /dev/null
+++ b/wm3d/wm3d/data/benchmark_robonet.py
@@ -0,0 +1,182 @@
+"""RoboNet measured command/frame adapter for the complete native model.
+
+Time is recorded-frame ordinal, NOT a claimed physical control frequency.
+Two real overlapping K8 crops cover the twelve-frame protocol window.
+"""
+from __future__ import annotations
+import io
+import json
+import math
+from pathlib import Path
+from types import SimpleNamespace
+import h5py
+import av
+import numpy as np
+import torch
+from torch.utils.data import Dataset
+from .benchmark_catalog import binding, read_rows
+from .step_sampler import AffinePermutation
+
+TASK = "Interact with objects using the robot."
+ROBOTS = ("sawyer", "widowx", "R3", "baxter", "kuka", "fetch", "franka")
+
+def normalization_key(row,adim,sdim):
+    return json.dumps([row["robot"],row["action_space"],row["gripper"],adim,sdim],separators=(",",":"))
+
+def decode(h, row):
+    camera = h["env/cam0_video"]
+    if row["video_encoding"] == "mp4":
+        with av.open(io.BytesIO(camera["frames"][:].tobytes()), mode="r") as container:
+            stream = container.streams.video[0]
+            stream.thread_count = 1
+            frames = np.stack([frame.to_ndarray(format="rgb24")
+                               for frame in container.decode(stream)])
+    elif row["video_encoding"] == "jpg":
+        import cv2
+        frames = np.stack([cv2.imdecode(camera["frame"+str(i)][:], cv2.IMREAD_COLOR)[..., ::-1]
+                           for i in range(row["declared_video_frames"])])
+    else:
+        raise ValueError("unresolved native encoding")
+    if len(frames) != row["declared_video_frames"]:
+        raise ValueError("actual decoded frame cardinality differs from recorded T")
+    if row["image_format"] == "BGR":
+        frames = frames[..., ::-1].copy()
+    elif row["image_format"] != "RGB":
+        raise ValueError("unresolved native color order")
+    return frames
+
+def robot(h, row):
+    action = np.asarray(h["policy/actions"], dtype=np.float32)
+    state = np.asarray(h["env/state"], dtype=np.float32)
+    if not np.isfinite(action).all() or not np.isfinite(state).all():
+        raise ValueError("nonfinite native robot array")
+    if action.shape[1] == 4 and row["primitives"] == "autograsp":
+        if row["low_bound"] is None or row["high_bound"] is None:
+            lo=np.asarray(h["env/low_bound"],dtype=np.float32)
+            hi=np.asarray(h["env/high_bound"],dtype=np.float32)
+            lo=lo[1:len(action)+1,-1] if lo.ndim==2 else lo[-1]
+            hi=hi[1:len(action)+1,-1] if hi.ndim==2 else hi[-1]
+        else:
+            lo, hi = row["low_bound"][-1], row["high_bound"][-1]
+        gripper = np.where(state[1:len(action)+1,-1] > (lo+hi)/2, hi, lo).astype(np.float32)
+        action = np.column_stack((action, gripper))
+    # Keep source x,y[,z,theta,gripper], with no synthetic xyz or rotations.
+    if action.shape[1] not in (2,4,5) or state.shape[1] not in (3,5):
+        raise ValueError("unresolved native robot width")
+    return action, state
+
+class RoboNetNativeDataset(Dataset):
+    requires_main_process = False
+    def __init__(self, catalog, *, split="train", normalization=None):
+        self.rows = list(read_rows(catalog))
+        self.split = split
+        self.stats = json.loads(Path(normalization).read_text())["groups"] if normalization else None
+        self.trajectories = len(self.rows)
+        self.source_names = ("robonet",)
+        self.source_spans = {"robonet": (0, self.trajectories * (80 if split=="train" else 1))}
+        self.source_sampling_weights = {"robonet":1}
+        self.profile = SimpleNamespace(source_weights=self.source_sampling_weights,
+            source_order=self.source_names, cache_representation=dict(spatial_tokens=64,token_dim=2048,num_views=3,rgb_size=518))
+    def __len__(self):
+        return self.source_spans["robonet"][1]
+    def __getitem__(self,index):
+        from scripts.data.run_cache_worker import _view_batch
+        visit, episode = divmod(int(index), self.trajectories)
+        row = self.rows[episode]
+        before = binding(row["file"])
+        for key in ("inode","size_bytes","mtime_ns","ctime_ns"):
+            if before[key] != row["file_binding"][key]:
+                raise ValueError("RoboNet native file changed")
+        with h5py.File(row["file"],"r") as h:
+            frames = decode(h,row)
+            action,state = robot(h,row)
+        if binding(row["file"]) != before:
+            raise ValueError("native file changed while reading")
+        windows = row["valid12_frame_starts"]
+        start = AffinePermutation(windows,seed=(3407 if self.split=="train" else 7340),source_name=row["id"]).at(visit)
+        crop = (visit%2)*2 if self.split=="train" else 0
+        anchor = start+1+crop
+        selected = anchor+np.arange(9)
+        decoded = {"front":SimpleNamespace(frames=frames[selected])}
+        images,masks = _view_batch(decoded=decoded,slots=("front","left","right"),input_size=518)
+        rgb = torch.zeros(24,3,3,518,518,dtype=torch.uint8)
+        view = torch.zeros(24,3,dtype=torch.bool)
+        rgb[14,0] = torch.nn.functional.interpolate(torch.from_numpy(frames[anchor-1].copy()).permute(2,0,1)[None].float(),size=(518,518),mode="bilinear",align_corners=False)[0].round().clamp(0,255).byte()
+        view[14,0] = True
+        rgb[15:] = images.mul(255).round().clamp(0,255).byte()
+        view[15:] = masks
+        keys=torch.full((24,),-1,dtype=torch.long)
+        keys[14:] = torch.from_numpy((episode<<32)+np.arange(anchor-1,anchor+9))
+        result=dict(direct_rgb_uint8=rgb,direct_view_mask=view,direct_frame_keys=keys,
+            source_id=torch.tensor(0),sample_index=torch.tensor(index),task_text=TASK,time_coordinate="ordinal_step",
+            embodiment_ids=torch.tensor(ROBOTS.index(row["robot"])+1),
+            action_group_ids=torch.tensor([13,0,0]),action_group_mask=torch.tensor([True,False,False]),
+            action_semantic_ids=torch.zeros(3,14,dtype=torch.long),state_semantic_ids=torch.zeros(3,10,dtype=torch.long),
+            action_normalization_offset=torch.zeros(3,14),action_normalization_scale=torch.ones(3,14),
+            state_normalization_offset=torch.zeros(3,10),state_normalization_scale=torch.ones(3,10),
+            current_state_values=torch.zeros(3,10),current_state_mask=torch.zeros(3,10,dtype=torch.bool),
+            history_world_boundaries_dt=torch.arange(-16,1,dtype=torch.float32),
+            future_world_boundaries_dt=torch.arange(9,dtype=torch.float32),
+            policy_query_dt=torch.zeros(3,8),policy_query_mask=torch.zeros(3,8,dtype=torch.bool),
+            target_fine_action=torch.zeros(3,8,14),target_fine_action_mask=torch.zeros(3,8,14,dtype=torch.bool))
+        adim,sdim=action.shape[1],state.shape[1]
+        if self.stats is not None:
+            stats=self.stats[normalization_key(row,adim,sdim)]
+            for name,values in (("action",action),("state",state)):
+                offset=np.asarray(stats[name]["offset"],np.float32)
+                scale=np.asarray(stats[name]["scale"],np.float32)
+                values-=offset
+                values/=scale
+                result[name+"_normalization_offset"][0,:len(offset)]=torch.from_numpy(offset)
+                result[name+"_normalization_scale"][0,:len(scale)]=torch.from_numpy(scale)
+        # Existing source recording units remain exact; physical units unresolved.
+        result["current_state_values"][0,:sdim]=torch.from_numpy(state[anchor])
+        result["current_state_mask"][0,:sdim]=True
+        # Recording metadata names x/y/z/theta but does not establish SI delta
+        # frames or close01 polarity for every robot. Preserve controller-native
+        # values rather than mislabel those heterogeneous units as SI poses.
+        result["action_semantic_ids"][0,:adim]=12
+        result["state_semantic_ids"][0,:sdim]=11
+        for prefix,length,first in (("history",16,anchor-16),("future_factual",8,anchor)):
+            values=torch.zeros(length,3,1,14)
+            mask=torch.zeros_like(values,dtype=torch.bool)
+            sample_mask=torch.zeros(length,3,1,dtype=torch.bool)
+            positions=first+np.arange(length)
+            active=positions>=0
+            values[:,0,0,:adim]=torch.from_numpy(action[np.maximum(positions,0)])*torch.from_numpy(active[:,None])
+            mask[:,0,0,:adim]=torch.from_numpy(np.broadcast_to(active[:,None],(length,adim)).copy())
+            sample_mask[:,0,0]=torch.from_numpy(active)
+            result[prefix+"_fine_action_values"]=values
+            result[prefix+"_fine_action_mask"]=mask
+            result[prefix+"_fine_sample_mask"]=sample_mask
+            result[prefix+"_fine_action_dt"]=torch.zeros(length,3,1)
+        result["policy_query_dt"][0]=torch.arange(8)
+        result["policy_query_mask"][0]=True
+        result["target_fine_action"][0,:,:adim]=torch.from_numpy(action[anchor:anchor+8])
+        result["target_fine_action_mask"][0,:,:adim]=True
+        return result
+
+class RoboNetTrajectorySampler:
+    """Step-addressed 80 complete trajectory traversals; final padding only."""
+    def __init__(self,dataset,*,world_size,rank,micro_batch_size,gradient_accumulation,start_step,num_steps):
+        self.dataset=dataset
+        self.world_size,self.rank=world_size,rank
+        self.micro,self.accum=micro_batch_size,gradient_accumulation
+        self.start,self.steps=start_step,num_steps
+        self.order=AffinePermutation(dataset.trajectories,seed=3407,source_name="robonet_trajectory")
+    def __len__(self): return self.steps*self.accum
+    def __iter__(self):
+        n=self.dataset.trajectories
+        global_batch=self.world_size*self.micro*self.accum
+        for step in range(self.start,self.start+self.steps):
+            for micro in range(self.accum):
+                result=[]
+                for j in range(self.micro):
+                    draw=step*global_batch+micro*self.world_size*self.micro+self.rank*self.micro+j
+                    if draw>=n*80:
+                        # Forty-eight rounding draws repeat the first distinct
+                        # trajectories of the final pass, not one clip48times.
+                        draw=79*n+(draw-n*80)
+                    visit,pos=divmod(draw,n)
+                    result.append(visit*n+self.order.at(visit*n+pos))
+                yield result
