+"""Synchronous trainer-owned fixed-validation selection, separate from retention."""
+import fcntl
+import json
+import math
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import torch.distributed as dist
+from .benchmark_checkpoint import BASE,RUNS,MIN_FREE
+from .distributed_checkpoint import _atomic_json
+
+def preserve_selected_model(config,*,completed,validation,context):
+    total=config['runtime_profile']['train']['total_steps']
+    if completed<math.ceil(total*.75) or validation is None:return
+    result=[None]
+    if context.is_rank0:
+        fd=None
+        try:
+            score=float(validation['loss_video'])
+            if not math.isfinite(score):raise ValueError('fixed-val video loss nonfinite')
+            root=Path(config['run']['output_root'])
+            previous=root/'BEST_VALIDATION_MODEL.json'
+            old=json.loads(previous.read_text()) if previous.exists() else None
+            is_best=old is None or score<float(old['validation_video_loss'])
+            if not is_best:
+                if completed==total:
+                    _atomic_json(root/'FINAL_MODEL.json',dict(passed=True,step=completed,full_checkpoint=str(root/'checkpoints'/f'step_{completed:08d}'),always_retained_final=True,validation=validation),exclusive=False)
+                result[0]=dict(passed=True,selected=False)
+            else:
+                fd=os.open(RUNS/'.checkpoint_operation.lock',os.O_CREAT|os.O_RDWR|os.O_NOFOLLOW,0o600)
+                fcntl.flock(fd,fcntl.LOCK_EX)
+                checkpoint=root/'checkpoints'/f'step_{completed:08d}'
+                metadata=json.loads((checkpoint/'metadata.json').read_text())
+                if metadata['step']!=completed or metadata['run_lineage']!=config['run']['lineage']:raise ValueError('selected checkpoint differs')
+                mount=Path('/data/Minko/wm3d_native_fresh_node44_20260930/mounts/run')
+                remote_cp=mount/checkpoint.relative_to(BASE)
+                artifact_root=Path('/data/Minko/wm3d_downstream_artifacts_20261028/robonet')/root.name
+                kind='best_model'
+                destination=artifact_root/(kind+'.safetensors')
+                helper='/data/Minko/wm3d_downstream_artifacts_20261028/robonet_export_selection.py'
+                helper_identity=config['data_closure']['selection_exporter_node44_identity']
+                command='cd /data/Minko && systemd-run --quiet --wait --pipe --collect -p WorkingDirectory=/data/Minko -p MemoryMax=160G -p CPUQuota=200% -p Nice=15 -p IOSchedulingClass=idle -E CUDA_VISIBLE_DEVICES= -E PYTHONDONTWRITEBYTECODE=1 /data/Minko/.venvs/wm3d-foundation-v10-final/bin/python '+shlex.quote(helper)+' --checkpoint '+shlex.quote(str(remote_cp))+' --destination '+shlex.quote(str(destination))+' --source-header '+shlex.quote(str(mount/'downstream_handoff_20261028/final_model.safetensors'))+' --step '+str(completed)+' --self-identity-json '+shlex.quote(json.dumps(helper_identity))
+                cp=subprocess.run(['ssh','-T','-o','BatchMode=yes','-S',str(BASE/'control_20261001/ssh44.sock'),'root@172.27.0.7',command],capture_output=True,text=True,timeout=3600)
+                if cp.returncode:raise RuntimeError('selected model CPU export failed: '+cp.stderr[-3000:])
+                exported=json.loads(cp.stdout.splitlines()[-1])
+                if not (exported['passed'] and exported['all_tensors_finite'] and exported['source_step']==completed and exported['tensors']==2354 and not exported['GPU_initialized']):raise ValueError('selected model-only export proof failed')
+                v=os.statvfs(RUNS)
+                if v.f_bavail*v.f_frsize<MIN_FREE:raise ValueError('shared reserve changed during selected model export')
+                receipt=dict(passed=True,step=completed,validation_video_loss=score,validation=validation,artifact_node=44,artifact=str(destination),export=exported,fixed_validation_seed=7340,test_used_for_selection=False)
+                if is_best:_atomic_json(previous,receipt,exclusive=False)
+                if completed==total:_atomic_json(root/'FINAL_MODEL.json',receipt,exclusive=False)
+                result[0]=dict(passed=True,selected=is_best,artifact=str(destination))
+        except Exception as exc:
+            result[0]=dict(passed=False,error=repr(exc))
+        finally:
+            if fd is not None:fcntl.flock(fd,fcntl.LOCK_UN);os.close(fd)
+    dist.broadcast_object_list(result,src=0)
+    if not result[0]['passed']:raise RuntimeError('validation-selected model preservation failed: '+str(result[0]))
+    if context.is_rank0:print(json.dumps(dict(validation_model_preservation=result[0])),flush=True)
