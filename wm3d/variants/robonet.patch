+"""CPU-only native DCP model subset export on44's local artifact volume."""
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+import torch
+import torch.distributed.checkpoint as dcp
+from safetensors import safe_open
+from safetensors.torch import save_file
+
+def sig(p):
+    s=p.stat();return [s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns]
+
+def native_identity(root):
+    result={}
+    for p in sorted(root.rglob('*')):
+        if p.is_symlink():raise ValueError('selected native checkpoint may not contain symlinks')
+        if p.is_file():result[str(p.relative_to(root))]=sig(p)
+    return result
+
+def main():
+    parser=argparse.ArgumentParser()
+    parser.add_argument('--checkpoint',required=True,type=Path)
+    parser.add_argument('--destination',required=True,type=Path)
+    parser.add_argument('--source-header',required=True,type=Path)
+    parser.add_argument('--step',required=True,type=int)
+    parser.add_argument('--self-identity-json',required=True)
+    args=parser.parse_args()
+    self_identity=json.loads(args.self_identity_json)
+    if sig(Path(__file__))!=self_identity:raise ValueError('bound CPU export helper identity changed')
+    if Path.cwd()!=Path('/data/Minko') or os.environ.get('CUDA_VISIBLE_DEVICES')!='':raise ValueError('CPU export only')
+    torch.set_num_threads(2)
+    available=lambda:next(int(s.split()[1])*1024 for s in Path('/proc/meminfo').read_text().splitlines() if s.startswith('MemAvailable:'))
+    mem_before=available()
+    if mem_before<320*(1<<30):raise ValueError('CPU export cannot preserve160GiB RAM reserve under160G task cap')
+    commit=args.checkpoint/'COMMITTED.json'
+    original=sig(commit)
+    original_native=native_identity(args.checkpoint)
+    meta=json.loads((args.checkpoint/'metadata.json').read_text())
+    if meta['step']!=args.step or json.loads(commit.read_text())['step']!=args.step:raise ValueError('source DCP step differs')
+    reader=dcp.FileSystemReader(args.checkpoint/'distcp')
+    bounded_root=args.source_header.parents[1]/'formal_27source_2ep_20261005/training/checkpoint_retention/rolling_max4_20261014'
+    sys.path.insert(0,str(bounded_root))
+    from bounded_read import Pacer,FileSystem
+    pacer=Pacer(rate=128*(1<<20))
+    reader.fs=FileSystem(reader.fs,pacer)
+    metadata=reader.read_metadata().state_dict_metadata
+    state={}
+    with safe_open(str(args.source_header),framework='pt',device='cpu') as header:
+        names=list(header.keys())
+        if len(names)!=2354:raise ValueError('source complete model header differs')
+        for name in names:
+            item=metadata['model.'+name]
+            if tuple(item.size)!=tuple(header.get_slice(name).get_shape()):raise ValueError('DCP model shape differs')
+            if header.get_slice(name).get_dtype()!='F32' or item.properties.dtype!=torch.float32:raise ValueError('DCP inherited model dtype differs')
+            state[name]=torch.empty(tuple(item.size),dtype=item.properties.dtype,device='cpu')
+    if sum(x.numel() for x in state.values())!=7251084294:raise ValueError('full inherited model cardinality differs')
+    dcp.load({'model':state},storage_reader=reader,no_dist=True)
+    if not all(not x.is_floating_point() or bool(torch.isfinite(x).all()) for x in state.values()):raise FloatingPointError('selected model not finite')
+    if sig(commit)!=original:raise ValueError('source commit changed during model-only read')
+    if native_identity(args.checkpoint)!=original_native:raise ValueError('native source checkpoint changed during selected model export')
+    if available()<160*(1<<30):raise ValueError('actual160GiB RAM reserve lost during CPU export')
+    args.destination.parent.mkdir(parents=True,exist_ok=True)
+    v=os.statvfs(args.destination.parent)
+    required=sum(x.numel()*x.element_size() for x in state.values())
+    if v.f_bavail*v.f_frsize<required+32*(1<<30):raise ValueError('local44 artifact free space insufficient')
+    tmp=args.destination.with_name('.'+args.destination.name+'.incomplete.'+str(os.getpid()))
+    save_file(state,str(tmp),metadata={'source_step':str(args.step),'kind':'validation_selected_complete_model_only'})
+    with tmp.open('rb') as handle:os.fsync(handle.fileno())
+    with safe_open(str(tmp),framework='pt',device='cpu') as exported:
+        if set(exported.keys())!=set(state):raise ValueError('export omitted model names')
+        for name,value in state.items():
+            if tuple(exported.get_slice(name).get_shape())!=tuple(value.shape):raise ValueError('export shape differs')
+    os.replace(tmp,args.destination)
+    directory_fd=os.open(args.destination.parent,os.O_RDONLY|os.O_DIRECTORY)
+    try:os.fsync(directory_fd)
+    finally:os.close(directory_fd)
+    if sig(Path(__file__))!=self_identity:raise ValueError('CPU export helper changed during task')
+    result=dict(passed=True,model_only=True,all_tensors_finite=True,tensors=len(state),elements=sum(x.numel() for x in state.values()),source_checkpoint=str(args.checkpoint),source_step=args.step,source_commit_identity=original,source_native_stat_identity=original_native,source_unchanged=True,artifact=str(args.destination),artifact_identity=sig(args.destination),GPU_initialized=torch.cuda.is_initialized(),optimizer_or_sampler_exported=False,actual_reader_bytes=pacer.bytes,actual_read_rate_limit_bytes_per_second=pacer.rate,actual_read_seconds=time.monotonic()-pacer.started,MemAvailable_before=mem_before,MemAvailable_after=available(),resource_contract=dict(MemoryMax='160G',CPUQuota='200%',Nice=15,IOSchedulingClass='idle'))
+    receipt=args.destination.with_suffix('.json')
+    receipt_tmp=receipt.with_name('.'+receipt.name+'.incomplete.'+str(os.getpid()))
+    receipt_tmp.write_text(json.dumps(result,indent=2)+'\n')
+    with receipt_tmp.open('rb') as handle:os.fsync(handle.fileno())
+    os.replace(receipt_tmp,receipt)
+    directory_fd=os.open(receipt.parent,os.O_RDONLY|os.O_DIRECTORY)
+    try:os.fsync(directory_fd)
+    finally:os.close(directory_fd)
+    print(json.dumps(result),flush=True)
+
+if __name__=='__main__':main()
