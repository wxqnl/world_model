+    recipe['train']['checkpoint_steps']=[2]
+    recipe['train']['downstream_initialization']=dict(schema='wm3d_benchmark_final_model_initialization_v1',benchmark='WorldArena',
+        source_step=167446,authority_path=str(R/'USER_START_AFTER_PRETRAINING.json'),handoff_manifest_path=str(H/'MODEL_ONLY_READY.json'),
+        source_model_config_path=str(H/'SOURCE_MODEL_CONFIG.json'))
+    model=copy.deepcopy(sourcecfg['model_profile']);model['name']='worldarena_native_ordinal'
+    model['model'].update(action_loss_weight=1.,video_loss_weight=1.,native_3d_loss_weight=.1,wan_context_store_path=str(D/'foundation_context'))
