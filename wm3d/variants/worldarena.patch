+    ds=WorldArenaNativeDataset(catalog,normalization)
+    if not proof.exists():
+        checked=[]
+        for i in (0,len(ds)//3,len(ds)//2,len(ds)-1):
+            batch=build_foundation_sample(_collate_and_trim([ds[i]]),FoundationBridgeConfig())
+            if batch['action'].shape!=(1,8,42) or batch['video'].shape!=(1,3,9,384,320):
+                raise ValueError('native real batch shape mismatch')
+            if batch['time_coordinate_unit']!='ordinal_step' or 'action_time_s' in batch:
+                raise ValueError('unlabelled time semantics')
+            if not torch.isfinite(batch['action']).all() or not torch.isfinite(batch['video']).all():
+                raise ValueError('nonfinite native batch')
