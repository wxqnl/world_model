+        catalog_path=str(catalog),catalog_binding=binding(catalog),normalization_path=str(normalization),normalization_binding=binding(normalization),
+        raw_file_bindings=json.loads(normalization.read_text())['files'],encoder_contract_path=str(encoder),encoder_contract_binding=binding(encoder),
+        CPU_materialization_proof_path=str(proof),CPU_materialization_proof_binding=binding(proof))
