+            ('objective_profile_sha256',runtime['objective_profile']),('model_contract_sha256',dict(architecture=model['architecture'],model=model['model'])))}
+        validate_materialized_runtime(runtime)
+        destination=R/'worldarena'/('runtime_'+suffix+'.json')
+        if destination.exists():raise ValueError('refusing runtime replacement '+str(destination))
+        publish(destination,runtime)
+        print(json.dumps(dict(runtime=str(destination),validated=True,output=run['output_root'])),flush=True)
+if __name__=='__main__':main()
