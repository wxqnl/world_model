+"""All official WorldArena train videos, original sampled drive targets and RGB.
+
+The generator saves segment starts, periodic controller snapshots and segment
+ends. Their physical timestamps are not stored. Coordinates are therefore
+explicit ordinal_step, never seconds/Hz, without interpolation or repetition.
+"""
+from bisect import bisect_right
+from collections import OrderedDict
+import io
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import h5py
+import numpy as np
+from PIL import Image
+import torch
+from torch.utils.data import Dataset
+
+from .benchmark_catalog import binding, publish, read_rows
+from .benchmark_libero import Moments
+
+SCHEMA = 'wm3d_worldarena_native_normalization_v1'
+
+def canonical_robot(h):
+    action = np.asarray(h['joint_action/vector'], dtype=np.float32).reshape(-1,2,7)
+    states = []
+    for side in ('left','right'):
+        pose = np.asarray(h[f'endpose/{side}_endpose'], dtype=np.float64)
+        q = pose[:,3:]
+        if not np.allclose(np.linalg.norm(q,axis=1),1,atol=.002):
+            raise ValueError('nonunit recorded wxyz quaternion')
+        w,x,y,z = q.T
+        rotation = np.stack((1-2*(y*y+z*z),2*(x*y-z*w),2*(x*z+y*w),
+                             2*(x*y+z*w),1-2*(x*x+z*z),2*(y*z-x*w),
+                             2*(x*z-y*w),2*(y*z+x*w),1-2*(x*x+y*y)),axis=1).reshape(-1,3,3)
+        r6 = rotation[:,:,:2].transpose(0,2,1).reshape(-1,6)
+        grip = np.asarray(h[f'endpose/{side}_gripper'])
+        states.append(np.column_stack((pose[:,:3],r6,grip)))
+    state = np.stack(states,axis=1).astype(np.float32)
+    if not (np.isfinite(action).all() and np.isfinite(state).all()):
+        raise ValueError('nonfinite source robot measurements')
+    if np.any(action[:,:,6] < -.001) or np.any(action[:,:,6] > 1.001):
+        raise ValueError('source gripper not open01')
+    return action,state
+
+def fit(catalog,destination):
+    rows=list(read_rows(catalog))
+    if len(rows)!=2000 or any(r['split']!='train' for r in rows):
+        raise ValueError('train-only complete 2000 video normalization required')
+    am,sm=Moments(14),Moments(20)
+    files={}
+    for row in rows:
+        if binding(row['file']) != row['file_binding']:
+            raise ValueError('source identity changed')
+        with h5py.File(row['file'],'r') as h:
+            action,state=canonical_robot(h)
+        am.add(action.reshape(-1,14)); sm.add(state.reshape(-1,20))
+        files[row['file']]=row['file_binding']
+    a,s=am.export(),sm.export()
+    for i in (6,13): a['offset'][i],a['scale'][i]=0.,1.
+    for i in (9,19): s['offset'][i],s['scale'][i]=0.,1.
+    value=dict(schema=SCHEMA,train_videos=2000,fitting_split='train',catalog=str(catalog),
+        catalog_binding=binding(catalog),files=files,action=a,state=s,
+        time_coordinate_unit='ordinal_step',physical_clock_available=False,
+        physical_clock_unavailable_reason='HDF5 has no timestamps; segment endpoint snapshots make save_freq nonuniform; trajectory plans do not record full control-call and gripper order',
+        generator_provenance=dict(observation='/data/Minko/external/FastWAM/third_party/RoboTwin/envs/_base_task.py:508-516',
+            drive_target='/data/Minko/external/FastWAM/third_party/RoboTwin/envs/robot/robot.py:494-506',
+            real_qpos_distinct='/data/Minko/external/FastWAM/third_party/RoboTwin/envs/robot/robot.py:508',
+            snapshot_sampling='/data/Minko/external/FastWAM/third_party/RoboTwin/envs/_base_task.py:1429-1497'),
+        action_semantics='two groups of six joint_position_rad drive targets and absolute_gripper_open01',
+        state_semantics='per-arm xyz metres, wxyz quaternion converted to rotation6d columns, gripper_open01',
+        no_physical_cadence_inferred=True,no_interpolation_or_repetition=True)
+    publish(destination,value)
+    return value
+
+class WorldArenaNativeDataset(Dataset):
+    requires_main_process=False
+    episode_balanced=True
+    def __init__(self,catalog,normalization,**kwargs):
+        self.rows=list(read_rows(catalog)); self.stats=json.loads(Path(normalization).read_text())
+        if self.stats['schema'] != SCHEMA or len(self.rows)!=2000:
+            raise ValueError('wrong WorldArena train closure')
+        self.files=kwargs.get('file_bindings') or self.stats['files']
+        self.ends=[]; spans=[]; cursor=0
+        for row in self.rows:
+            count=row['full_native_K8_windows_with_prior']
+            spans.append((cursor,cursor+count));cursor+=count;self.ends.append(cursor)
+        self.source_names=('worldarena',);self.source_spans={'worldarena':(0,cursor)}
+        self.source_episode_spans={'worldarena':tuple(spans)}
+        self.source_sampling_weights={'worldarena':1}
+        self.profile=SimpleNamespace(source_weights=self.source_sampling_weights,source_order=self.source_names,
+            cache_representation=dict(spatial_tokens=64,token_dim=2048,num_views=3,rgb_size=518))
+        self._open=OrderedDict();self._robot=OrderedDict()
+        self.ao=np.asarray(self.stats['action']['offset'],np.float32).reshape(2,7)
+        self.asc=np.asarray(self.stats['action']['scale'],np.float32).reshape(2,7)
+        self.so=np.asarray(self.stats['state']['offset'],np.float32).reshape(2,10)
+        self.ssc=np.asarray(self.stats['state']['scale'],np.float32).reshape(2,10)
+    def __len__(self):return self.ends[-1]
+    def __getitem__(self,index):
+        from scripts.data.run_cache_worker import _view_batch
+        index=int(index); episode=bisect_right(self.ends,index)
+        row=self.rows[episode];base=0 if episode==0 else self.ends[episode-1]
+        anchor=1+index-base;path=row['file']
+        if path not in self._open:
+            from .benchmark_native import verify
+            verify(path,self.files[path]);self._open[path]=h5py.File(path,'r')
+        self._open.move_to_end(path)
+        while len(self._open)>2:self._open.popitem(last=False)[1].close()
+        h=self._open[path]
+        if episode not in self._robot:
+            a,s=canonical_robot(h);self._robot[episode]=((a-self.ao)/self.asc,(s-self.so)/self.ssc)
+        self._robot.move_to_end(episode)
+        while len(self._robot)>8:self._robot.popitem(last=False)
+        action,state=self._robot[episode]
+        selected=anchor+np.arange(9,dtype=np.int64)
+        decoded={}
+        for camera in row['camera_names']:
+            frames=[]
+            for t in selected:
+                encoded=h[f'observation/{camera}/rgb'][t]
+                payload=bytes(encoded) if isinstance(encoded,(bytes,np.bytes_)) else np.asarray(encoded,np.uint8).tobytes()
+                with Image.open(io.BytesIO(payload)) as image:
+                    frames.append(np.asarray(image.convert('RGB')))
+            decoded[camera]=SimpleNamespace(frames=np.stack(frames))
+        images,masks=_view_batch(decoded=decoded,slots=tuple(row['camera_names']),input_size=518)
+        rgb=torch.zeros(24,3,3,518,518,dtype=torch.uint8); view=torch.zeros(24,3,dtype=torch.bool)
+        rgb[15:]=images.mul(255).round().clamp_(0,255).to(torch.uint8);view[15:]=masks
+        keys=torch.full((24,),-1,dtype=torch.long);keys[15:]=torch.from_numpy((episode<<32)+selected)
+        result=dict(direct_rgb_uint8=rgb,direct_view_mask=view,direct_frame_keys=keys,
+            source_id=torch.tensor(0),sample_index=torch.tensor(index),
+            task_text=row['instruction_payload']['seen'][0].strip(),embodiment_ids=torch.tensor(230),
+            action_group_ids=torch.tensor([20,21,0]),action_group_mask=torch.tensor([True,True,False]),
+            action_semantic_ids=torch.zeros(3,14,dtype=torch.long),state_semantic_ids=torch.zeros(3,10,dtype=torch.long),
+            action_normalization_offset=torch.zeros(3,14),action_normalization_scale=torch.ones(3,14),
+            state_normalization_offset=torch.zeros(3,10),state_normalization_scale=torch.ones(3,10),
+            current_state_values=torch.zeros(3,10),current_state_mask=torch.zeros(3,10,dtype=torch.bool),
+            history_world_boundaries_dt=torch.arange(-16,1,dtype=torch.float32),
+            future_world_boundaries_dt=torch.arange(9,dtype=torch.float32),
+            time_coordinate_unit='ordinal_step',physical_clock_available=False,
+            policy_query_dt=torch.zeros(3,32),policy_query_mask=torch.zeros(3,32,dtype=torch.bool),
+            target_fine_action=torch.zeros(3,32,14),target_fine_action_mask=torch.zeros(3,32,14,dtype=torch.bool))
+        result['action_semantic_ids'][:2,:7]=torch.tensor([6,6,6,6,6,6,4])
+        result['state_semantic_ids'][:2]=torch.tensor([1,1,1,2,2,2,2,2,2,3])
+        for name,value in (('action_normalization_offset',self.ao),('action_normalization_scale',self.asc),
+                           ('state_normalization_offset',self.so),('state_normalization_scale',self.ssc)):
+            result[name][:2,:value.shape[1]]=torch.from_numpy(value)
+        result['current_state_values'][:2]=torch.from_numpy(state[anchor]);result['current_state_mask'][:2]=True
+        # Exactly one recorded command per observed interval. No fake high-rate commands.
+        for prefix,length,first in (('history',16,anchor-16),('future_factual',8,anchor)):
+            ids=first+np.arange(length);active=ids>=0;safe=np.maximum(ids,0)
+            values=torch.zeros(length,3,1,14);mask=torch.zeros_like(values,dtype=torch.bool)
+            samples=torch.zeros(length,3,1,dtype=torch.bool);dt=torch.zeros(length,3,1)
+            values[:,:2,0,:7]=torch.from_numpy(action[safe])*torch.from_numpy(active[:,None,None])
+            mask[:,:2,0,:7]=torch.from_numpy(np.broadcast_to(active[:,None,None],(length,2,7)).copy())
+            samples[:,:2,0]=torch.from_numpy(np.broadcast_to(active[:,None],(length,2)).copy())
+            result[prefix+'_fine_action_values']=values;result[prefix+'_fine_action_mask']=mask
+            result[prefix+'_fine_action_dt']=dt;result[prefix+'_fine_sample_mask']=samples
+        result['policy_query_dt'][:2,:8]=torch.arange(8,dtype=torch.float32)
+        result['policy_query_mask'][:2,:8]=True
+        result['target_fine_action'][:2,:8,:7]=torch.from_numpy(action[anchor:anchor+8].transpose(1,0,2))
+        result['target_fine_action_mask'][:2,:8,:7]=True
+        return result
+
+    def close(self):
+        for h in self._open.values():h.close()
+        self._open.clear();self._robot.clear()
+
+def validate_closure(closure,model_profile,runtime_profile):
+    from .benchmark_native import verify
+    for p,b in (('catalog_path','catalog_binding'),('normalization_path','normalization_binding'),
+                ('encoder_contract_path','encoder_contract_binding'),('CPU_materialization_proof_path','CPU_materialization_proof_binding')):
+        verify(closure[p],closure[b])
+    rows=list(read_rows(closure['catalog_path']))
+    normal=json.loads(Path(closure['normalization_path']).read_text())
+    proof=json.loads(Path(closure['CPU_materialization_proof_path']).read_text())
+    if len(rows)!=2000 or any(r['split']!='train' for r in rows):raise ValueError('incomplete train split')
+    if normal['schema']!=SCHEMA or normal['fitting_split']!='train' or normal['train_videos']!=2000:
+        raise ValueError('WorldArena normalization must be complete and train-only')
+    if set(closure['raw_file_bindings'])!={r['file'] for r in rows} or set(normal['files'])!=set(closure['raw_file_bindings']):
+        raise ValueError('WorldArena raw-file closure incomplete')
+    for p,b in closure['raw_file_bindings'].items():verify(p,b)
+    if not (proof['passed'] and proof['foundation_bridge_passed'] and proof['actual_current_future_RGB_decoded']):
+        raise ValueError('real CPU materialization is missing')
+    if normal['time_coordinate_unit']!='ordinal_step' or normal['physical_clock_available']:
+        raise ValueError('unresolved source clock cannot claim seconds')
+    from .foundation_input import FoundationContextStore
+    model=model_profile['model'];bank=FoundationContextStore.from_directory(model['wan_context_store_path'])
+    bank.lookup(sorted({r['instruction_payload']['seen'][0].strip() for r in rows}))
+    if bank.prompt_format!=model['wan_prompt_format']:raise ValueError('instruction feature format changed')
+    train=runtime_profile['train']
+    if train['global_batch_size']!=128 or train['total_steps']!=20000 or train['validate_every']!=0:
+        raise ValueError('fixed WorldArena training budget changed')
+    if train['downstream_initialization']['benchmark']!='WorldArena':raise ValueError('wrong initialization')
+    return dict(native_windows=sum(r['full_native_K8_windows_with_prior'] for r in rows),train_videos=2000,
+                train_only_normalization=True,time_coordinate_unit='ordinal_step',physical_clock_available=False)
+
+from .step_sampler import StepAddressedBatchSampler, AffinePermutation
+
+class _EpisodeBalancedPermutation:
+    def __init__(self,spans,seed):
+        self.spans=tuple(spans);self.seed=seed
+        self.order=AffinePermutation(len(spans),seed=seed,source_name='worldarena-video-order')
+        self.starts=[AffinePermutation(stop-start,seed=seed,source_name=f'worldarena-video-{i}')
+                     for i,(start,stop) in enumerate(spans)]
+    def at(self,position):
