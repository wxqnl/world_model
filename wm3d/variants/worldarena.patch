+"""Prepare complete train-only WorldArena source instruction inventory."""
+import json
+from pathlib import Path
+
+ROOT = Path('/data/Minko/wm3d_downstream_20261028')
+
+def main():
+    rows = [json.loads(line) for line in (ROOT/'native_metadata_20261028_2012/worldarena/train.jsonl').read_text().splitlines()]
+    if len(rows) != 2000 or any(row['split'] != 'train' for row in rows):
+        raise ValueError('WorldArena requires all 2000 train videos')
+    dest = ROOT/'worldarena/native_data_20261028'
+    dest.mkdir(exist_ok=True)
+    inventory = sorted({row['instruction_payload']['seen'][0].strip() for row in rows})
+    if any(not text for text in inventory):
+        raise ValueError('empty source instruction')
+    (dest/'task_bank.jsonl').write_text(''.join(json.dumps({'text':text},ensure_ascii=False)+'\n' for text in inventory))
+    print(json.dumps({'train_videos':len(rows),'source_instructions':len(inventory),'inventory':str(dest/'task_bank.jsonl')}))
+
+if __name__ == '__main__':
+    main()
+
