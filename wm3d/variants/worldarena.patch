+            train_only_normalization=True,train_videos=2000,valid_windows=len(ds),actual_windows_checked=checked,
+            every_video_once_per_2000_positions=True,start_per_video_without_replacement=True,
+            time_coordinate_unit='ordinal_step',physical_clock_available=False))
