# WM3D-V7 的 5B/H200 站点配置示例。

# ===== 必填 =====
WORK_ROOT=/shared/wm3d_v7_native5b
HF_TOKEN_FILE=/shared/secrets/huggingface_token
SLURM_PARTITION=h200
SLURM_ACCOUNT=

# 使用站点已有的 Python 3.10 创建 venv。
SYSTEM_PYTHON=python3.10

# 网络较慢时可在 setup 命令前临时设置 PIP_INDEX_URL；不要把凭据写入本文件。
# 例：PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple ./run_v7.sh setup site.env

# 先在 Hugging Face 接受 AgiBot Alpha/Beta 许可，再改为 YES。
ACCEPT_DATA_LICENSES=NO

# ===== 路径，通常不用改 =====
RAW_ROOT="${WORK_ROOT}/raw"
RELEASE_ROOT="${WORK_ROOT}/release"
DATASET_ROOT="${WORK_ROOT}/datasets/v7_native5b_public6106h_v1"
ASSET_ROOT="${WORK_ROOT}/datasets/v7_native5b_encoder_assets_v1"
RUNS_ROOT="${WORK_ROOT}/runs"
LOG_ROOT="${WORK_ROOT}/logs"
STAGING_ROOT="${WORK_ROOT}/staging"
ENV_ROOT="${WORK_ROOT}/envs"
PYTHON_BIN="${ENV_ROOT}/wm3d-v7/bin/python"
TORCHRUN_BIN="${ENV_ROOT}/wm3d-v7/bin/torchrun"
CONVERTER_PYTHON_BIN="${ENV_ROOT}/agibot-v2-converter/bin/python"

# ===== 5B 示例：16×8 H200；最低可改为 8×8 =====
TRAIN_NODES=16
TRAIN_GPUS_PER_NODE=8
GLOBAL_BATCH_SIZE=128
MICRO_BATCH_SIZE=1
SHARD_DEGREE=8
CANARY_RUN_NAME=v7_native5b_canary1k
FORMAL_RUN_NAME=v7_native5b_formal600k
CANARY_CONFIG_TEMPLATE=configs/scale5b/wm3d_v7_native5b_h200_canary1k.template.yaml
FORMAL_CONFIG_TEMPLATE=configs/scale5b/wm3d_v7_native5b_h200.template.yaml

# ===== 不可变上游版本；AUTO 只解析一次并写入 lock =====
DROID_REVISION=AUTO
BRIDGE_REVISION=AUTO
ROBOCASA_ATOMIC_REVISION=AUTO
ROBOCASA_COMPOSITE_REVISION=AUTO
ROBOCASA_MG_REVISION=AUTO
AGIBOT_2026_REVISION=AUTO
AGIBOT_BETA_REVISION=AUTO
AGIBOT_ALPHA_REVISION=AUTO
VGGT_SOURCE_COMMIT=a288dd0f14786c93483e45524328726ab7b1b4ce
VGGT_MODEL_REVISION=860abec7937da0a4c03c41d3c269c366e82abdf9
TASK_MODEL_REVISION=AUTO

# ===== 数据并行度 =====
EXTRACT_SHARDS=256
EXTRACT_CONCURRENCY=64
ACTION_STATS_SHARDS=256
ACTION_STATS_CONCURRENCY=64
ENCODER_SHARDS=1024
ENCODER_CONCURRENCY=128
BETA_CONVERT_CONCURRENCY=64

# 6,106h 配方建议至少 100TB 当前可用空间；完整部署建议 200TB usable。
MIN_WORK_FREE_BYTES=100000000000000
EVAL_STEPS=64
SLURM_QOS=
SBATCH_EXTRA_ARGS=
