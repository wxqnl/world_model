# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG LEROBOT_REVISION=8e7d6970eaf5a64b8af6ec45586d201b8ca9ef16
ARG LEROBOT_SOURCE_SHA256=51e51e7e2d91c46db3bb4ccb9604d55776d9f9f90389465ed2603fe9f9bbc702
ARG LEROBOT_PYPROJECT_SHA256=34a923b9d6739c52d63af14d20282d5cbebbc78a46a81d76600ad33ae4057d66
ARG LEROBOT_POETRY_LOCK_SHA256=fabc7c9544e0073cabc2cf351c38b92a6f6578f343320be91a65c4050a7a10d3

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       ffmpeg \
       libglib2.0-0 \
       libgl1 \
       libsm6 \
       libxext6 \
    && rm -rf /var/lib/apt/lists/*

RUN python -c 'import platform; assert platform.python_version() == "3.10.15", platform.python_version()' \
    && python -m venv /opt/poetry \
    && /opt/poetry/bin/python -m pip install --no-cache-dir \
       'pip==24.3.1' \
       'poetry==1.8.5' \
       'poetry-plugin-export==1.8.0' \
    && python -m venv /opt/agibot-converter \
    && /opt/agibot-converter/bin/python -m pip install --no-cache-dir 'pip==24.3.1'

RUN mkdir -p /opt/src \
    && curl --fail --location --retry 5 \
       --output /tmp/lerobot.tar.gz \
       "https://github.com/huggingface/lerobot/archive/${LEROBOT_REVISION}.tar.gz" \
    && echo "${LEROBOT_SOURCE_SHA256}  /tmp/lerobot.tar.gz" | sha256sum --check - \
    && tar -xzf /tmp/lerobot.tar.gz -C /opt/src \
    && mv "/opt/src/lerobot-${LEROBOT_REVISION}" /opt/src/lerobot \
    && echo "${LEROBOT_PYPROJECT_SHA256}  /opt/src/lerobot/pyproject.toml" | sha256sum --check - \
    && echo "${LEROBOT_POETRY_LOCK_SHA256}  /opt/src/lerobot/poetry.lock" | sha256sum --check - \
    && cd /opt/src/lerobot \
    && /opt/poetry/bin/poetry check --lock \
    && /opt/poetry/bin/poetry export \
       --only main \
       --format requirements.txt \
       --output /tmp/lerobot-requirements.txt \
    && /opt/agibot-converter/bin/python -m pip install \
       --no-cache-dir \
       --require-hashes \
       --requirement /tmp/lerobot-requirements.txt \
    && /opt/poetry/bin/poetry build --format wheel \
    && /opt/agibot-converter/bin/python -m pip install \
       --no-cache-dir \
       --no-deps \
       /opt/src/lerobot/dist/lerobot-0.1.0-py3-none-any.whl \
    && /opt/agibot-converter/bin/python -m pip check \
    && printf '%s\n' "${LEROBOT_REVISION}" > /opt/agibot-converter/LEROBOT_REVISION

COPY environments/scale5b/agibot_converter_environment_contract.json \
     /opt/agibot-converter/environment_contract.json
COPY scripts/scale5b/verify_agibot_converter_environment.py \
     /opt/agibot-converter-tools/verify_agibot_converter_environment.py

RUN /opt/agibot-converter/bin/python \
      /opt/agibot-converter-tools/verify_agibot_converter_environment.py \
      --contract /opt/agibot-converter/environment_contract.json \
      --revision-file /opt/agibot-converter/LEROBOT_REVISION \
      --output /opt/agibot-converter/environment_receipt.json \
    && rm -rf \
       /opt/poetry \
       /opt/src \
       /root/.cache \
       /tmp/lerobot.tar.gz \
       /tmp/lerobot-requirements.txt

ENV PATH=/opt/agibot-converter/bin:${PATH} \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HUB_OFFLINE=1

LABEL org.opencontainers.image.title="WM3D-V7 AgiBot dataset-v2 converter runtime" \
      wm3d.v7.lerobot.revision="${LEROBOT_REVISION}"
CMD ["/bin/bash"]
