# WM3D H200 集群站点配置示例

# ===== 必填 =====
WORK_ROOT=/shared/wm3d
HF_TOKEN_FILE=/shared/secrets/huggingface_token
SLURM_PARTITION=h200
SLURM_ACCOUNT=

# 使用站点已有的 Python 3.10 创建 venv。
SYSTEM_PYTHON=python3.10

# 网络较慢时在 setup 命令前临时设置 PIP_INDEX_URL；凭据不要写入本文件。
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple ./wm3d.sh setup site.env

# 站点无法直连 huggingface.co 时启用兼容镜像；source lock 的 commit SHA 校验不变。
# HF_ENDPOINT=https://hf-mirror.com

# 在 Hugging Face 接受 AgiBot Alpha/Beta 许可后改为 YES。
ACCEPT_DATA_LICENSES=NO

# ===== 共享存储路径 =====
RAW_ROOT="${WORK_ROOT}/raw"
RELEASE_ROOT="${WORK_ROOT}/release"
DATASET_ROOT="${WORK_ROOT}/datasets/wm3d_v7_public6106h_v1"
ASSET_ROOT="${WORK_ROOT}/datasets/wm3d_v7_encoder_assets_v1"
RUNS_ROOT="${WORK_ROOT}/runs"
LOG_ROOT="${WORK_ROOT}/logs"
STAGING_ROOT="${WORK_ROOT}/staging"
ENV_ROOT="${WORK_ROOT}/envs"
PYTHON_BIN="${ENV_ROOT}/wm3d/bin/python"
TORCHRUN_BIN="${ENV_ROOT}/wm3d/bin/torchrun"
CONVERTER_PYTHON_BIN="${ENV_ROOT}/agibot-v2-converter/bin/python"

# ===== 当前 5B/H200 训练预设 =====
# 推荐 16×8 H200；最低可改为 8×8。
TRAIN_NODES=16
TRAIN_GPUS_PER_NODE=8
GLOBAL_BATCH_SIZE=128
MICRO_BATCH_SIZE=1
SHARD_DEGREE=8
CANARY_RUN_NAME=wm3d_5b_canary1k
FORMAL_RUN_NAME=wm3d_5b_formal600k
CANARY_CONFIG_TEMPLATE=configs/train/5b_h200_canary.yaml
FORMAL_CONFIG_TEMPLATE=configs/train/5b_h200.yaml

# ===== 不可变上游版本 =====
# AUTO 只在第一次 lock 时解析，之后使用 release/raw_sources.lock.yaml 中的 commit。
DROID_REVISION=AUTO
BRIDGE_REVISION=AUTO
ROBOCASA_ATOMIC_REVISION=AUTO
ROBOCASA_COMPOSITE_REVISION=AUTO
ROBOCASA_MG_REVISION=AUTO
AGIBOT_2026_REVISION=AUTO
AGIBOT_BETA_REVISION=AUTO
AGIBOT_ALPHA_REVISION=AUTO
VGGT_SOURCE_COMMIT=a288dd0f14786c93483e45524328726ab7b1b4ce
VGGT_SOURCE_ARCHIVE_SHA256=df4e7de1184bcb28ad6b4a83ead828f34ba42fb18be03c034801ffeb3a058f91
VGGT_SOURCE_TREE_SHA256=afc51bd052a538736830c33651f8f59f087629754298dd95d5d97a1a8bf99fa1
VGGT_MODEL_REVISION=860abec7937da0a4c03c41d3c269c366e82abdf9
TASK_MODEL_REVISION=AUTO

# ===== 数据任务并行度 =====
EXTRACT_SHARDS=256
EXTRACT_CONCURRENCY=64
ACTION_STATS_SHARDS=256
ACTION_STATS_CONCURRENCY=64
ENCODER_SHARDS=1024
ENCODER_CONCURRENCY=128
BETA_CONVERT_CONCURRENCY=64

# 6,106h 数据建议至少 100TB 当前可用空间；完整部署建议 200TB usable。
MIN_WORK_FREE_BYTES=100000000000000
EVAL_STEPS=64
SLURM_QOS=
SBATCH_EXTRA_ARGS=
