# --- wm3d_v5 .gitignore: track code + docs, exclude heavy/derived artifacts ---

# Python caches / build
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Training outputs & checkpoints (results/ is ~161GB)
results/
eval_artifacts/
*.pt
*.pth
*.ckpt
*.safetensors

# Vendored third-party (HunyuanVideo, VGGT, etc.) — not our source
external/

# Data manifests (large; regenerable via scripts/build_*_manifest.py)
manifests/

# Local backups / editor / OS cruft
*.bak
*.pathbak
*.gradbak
*.stage3bak
*.pointbak
*.orig
.DS_Store
